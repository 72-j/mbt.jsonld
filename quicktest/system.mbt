// System - 真实执行适配层 — Generated by QuickMachine Code Generator
// FSM: jsonld_dataset_ledger | Config: jsonld_conservation_machine
// Generated at: 1793000000000
// 手维护实例（.hand-maintained 在案）:P0 全重写接 jsonld 公面——生成骨架的
// A 式引擎假定（JqEvent/JqContext/JqEffect/Span）在 jsonld 无对应型, 全部拆除;
// 系统直调 @jsonld 桥（from_rdf_document / to_rdf_document / isomorphic_for_suite）,
// 守恒律双口径在 conserve_verify 落地: ①字面集守恒（键面规约 bnode）
// ②图同构守恒（isomorphic_for_suite 保 bnode 结构身份）。
// ========================================

// ===== 台账账本（系统侧真值） =====

///|
/// System: 被测系统 = jsonld 桥 + 台账（quad 池索引集, 与模型 quads 同构镜像）
priv struct System {
  mut ledger : Array[Int32]
}

///|
fn system_init() -> System {
  { ledger: [], }
}

///|
/// 台账 → N-Quads 原文（from_rdf 输入面; 池行结构化派生, 尾带换行）
fn ledger_text(ledger : Array[Int32]) -> String {
  let pool = quad_pool()
  let lines : Array[String] = []
  for index in ledger {
    lines.push(pool_line(pool[index]))
  }
  "\{lines.join("\n")}\n"
}

///|
/// 引擎 quad → 守恒键（与 pool_key 同构; bnode 标签规约, graph 位缺省当 ""）
fn quad_key(quad : @jsonld.JsonLdQuad) -> String {
  let graph = match quad.graph {
    Some(name) => name
    None => ""
  }
  "\{term_key(quad.subject)}|\{quad.predicate}|\{term_key(quad.object)}|\{graph}"
}

///|
/// 键集等值（排序后逐位比; 集合语义, 顺序无关——sort 全序形足用, 不求词典序）
fn same_key_set(left : Array[String], right : Array[String]) -> Bool {
  if left.length() != right.length() {
    return false
  }
  let sorted_left = left.copy()
  sorted_left.sort()
  let sorted_right = right.copy()
  sorted_right.sort()
  for position = 0; position < sorted_left.length(); position = position + 1 {
    if sorted_left[position] != sorted_right[position] {
      return false
    }
  }
  true
}

///|
/// 引擎 quads → N-Quads 原文（律②的第二轮 from_rdf 输入; quad 字段即
/// N-Terms 形, 直接拼行）
fn quads_text(quads : Array[@jsonld.JsonLdQuad]) -> String {
  let lines : Array[String] = []
  for quad in quads {
    let line = match quad.graph {
      Some(graph) =>
        "\{quad.subject} \{quad.predicate} \{quad.object} \{graph} ."
      None => "\{quad.subject} \{quad.predicate} \{quad.object} ."
    }
    lines.push(line)
  }
  "\{lines.join("\n")}\n"
}

///|
/// 桥选项（suite 通道同款: 显式全字段, 默认图语义）
fn bridge_options() -> @jsonld.JsonLdOptions {
  {
    load_context: None,
    rdf_direction: None,
    produce_generalized_rdf: false,
    compact_arrays: true,
    compact_to_relative: true,
    frame_expansion: false,
    omit_graph: false,
    base: None,
    expand_context: None,
    processing_mode: @jsonld.JsonLd11,
    use_native_types: false,
    use_rdf_type: false,
  }
}

///|
/// 守恒律双口径（本机的被测性质）:
/// ① 字面集守恒——to_rdf(from_rdf(台账)) 的 quad 键集 == 台账键集
///   （bnode 标签跨桥可能重编, 键面规约 "_:*" → "_:B"; 规约盲区由 ② 兜）
/// ② 图同构守恒——两轮 from_rdf 产物 isomorphic_for_suite 同构
///   （bnode 结构身份由同构判定保真）
/// 违律 → Error(1); 桥故障 → Error(2)
fn conserve_verify(system : System) -> Response {
  let document = match
    @jsonld.from_rdf_document(ledger_text(system.ledger), bridge_options()) {
    Ok(value) => value
    Err(_) => return Error(2)
  }
  let quads_back = match
    @jsonld.to_rdf_document(@jsonld.render_json(document), bridge_options()) {
    Ok(quads) => quads
    Err(_) => return Error(2)
  }
  let expected : Array[String] = []
  let pool = quad_pool()
  for index in system.ledger {
    expected.push(pool_key(pool[index]))
  }
  let observed : Array[String] = []
  for quad in quads_back {
    observed.push(quad_key(quad))
  }
  if !same_key_set(expected, observed) {
    return Error(1)
  }
  match @jsonld.from_rdf_document(quads_text(quads_back), bridge_options()) {
    Ok(document_back) =>
      if @jsonld.isomorphic_for_suite(document, document_back) {
        Continue
      } else {
        Error(1)
      }
    Err(_) => Error(2)
  }
}

///|
/// 真实执行: Command → 台账操作 → 过桥双验 → Response（守恒律即后置条件）
fn run_command(command : Command, system : System) -> Response {
  match command {
    Seed => {
      system.ledger = seed_indices()
      conserve_verify(system)
    }
    AppendQuad(reference) =>
      match quad_index(reference) {
        Some(index) =>
          if system.ledger.contains(index) {
            Error(0) // 台账集合口径: 重复追加被 valid 挡, 防御性归一
          } else {
            system.ledger.push(index)
            conserve_verify(system)
          }
        None => Error(3)
      }
    Roundtrip => conserve_verify(system)
  }
}

// ===== 守恒律测试（固定基线; 随机交错由 runner 的 qcs 门承担） =====

///|
test "jsonld 守恒律: Seed 基线过桥——双口径绿 + 台账像同步" {
  let system = system_init()
  assert_eq(run_command(Seed, system), Continue)
  assert_eq(system.ledger, seed_indices())
}

///|
test "jsonld 守恒律: 全池逐条追加（含 bnode 主/宾双形）双口径全绿" {
  let system = system_init()
  assert_eq(run_command(Seed, system), Continue)
  for index = 2; index < QUAD_POOL_LEN; index = index + 1 {
    assert_eq(
      run_command(AppendQuad(Concrete({ id: index, })), system),
      Continue,
    )
  }
  assert_eq(system.ledger.length(), QUAD_POOL_LEN)
  // 纯读回: Roundtrip 只验不改
  assert_eq(run_command(Roundtrip, system), Continue)
  assert_eq(system.ledger.length(), QUAD_POOL_LEN)
}

///|
test "jsonld 守恒律: 重复追加防御归一（集合口径, 不动账不过桥）" {
  let system = system_init()
  assert_eq(run_command(Seed, system), Continue)
  assert_eq(run_command(AppendQuad(Concrete({ id: 0, })), system), Error(0))
  assert_eq(system.ledger, seed_indices())
}

///|
test "jsonld_conservation_machine system: 模型像与系统账逐步同步" {
  // 双执行口径的首尾对账: 命令序列跑完, 模型台账像 == 系统 ledger
  let mut model = model_empty()
  let system = system_init()
  let script = [Seed, AppendQuad(Concrete({ id: 3, })), Roundtrip]
  for command in script {
    let (_, expected) = model_execute(model, command)
    assert_eq(run_command(command, system), expected)
    model = transition(model, command, expected)
  }
  assert_eq(model.quads, system.ledger)
}
