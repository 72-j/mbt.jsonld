// ===== P2 引用取值与权重 =====

///|
/// 引用取值范围（源 [business].ref_id_range）：越小越利于 shrink 收敛
const REF_ID_RANGE : Int32 = 6

///|
/// 命令权重（源 [business].weights；未声明默认 1，0 表示禁用）。
/// 权重只影响选择概率，合法性仍由 valid 过滤（转移表是唯一权威）。
fn command_weight(name : String) -> Int32 {
  match name {
    "Seed" => 3
    "Roundtrip" => 3
    "AppendQuad" => 5
    _ => 1
  }
}

///|
/// quad 池条目（结构化单源: N-Quads 行与守恒键都从这里派生）
priv struct PoolQuad {
  subject : String
  predicate : String
  object : String // N-Terms 形（IRI 尖括号 / 字面量引号 / _:bnode）
}

///|
/// quad 池（6 条, 索引 = 载荷 id 口径）: 0 IRI 宾词 / 1 朴素字面量 /
/// 2 语变字面量 / 3 型标字面量 / 4 bnode 主词 / 5 bnode 宾词。
/// 字面量均无空格（池行按空格自明; 系统侧对账走结构化键, 不解析行文）。
fn quad_pool() -> Array[PoolQuad] {
  [
    {
      subject: "<http://example.com/s1>",
      predicate: "<http://example.com/p1>",
      object: "<http://example.com/o1>",
    },
    {
      subject: "<http://example.com/s1>",
      predicate: "<http://example.com/p2>",
      object: "\"hello\"",
    },
    {
      subject: "<http://example.com/s2>",
      predicate: "<http://example.com/p1>",
      object: "\"bonjour\"@fr",
    },
    {
      subject: "<http://example.com/s2>",
      predicate: "<http://example.com/p3>",
      object: "\"42\"^^<http://www.w3.org/2001/XMLSchema#integer>",
    },
    {
      subject: "_:b1",
      predicate: "<http://example.com/p1>",
      object: "<http://example.com/o2>",
    },
    {
      subject: "<http://example.com/s1>",
      predicate: "<http://example.com/p4>",
      object: "_:b1",
    },
  ]
}

///|
/// Seed 的台账口径: 池[0] + 池[1]（模型像与系统账共用此定义）
fn seed_indices() -> Array[Int32] {
  [0, 1]
}

///|
/// bnode 标签规约（跨桥可能重编 _:label, 键面一律归 "_:B"）
fn term_key(term : String) -> String {
  if term.has_prefix("_:") {
    "_:B"
  } else {
    term
  }
}

///|
/// 台账 N-Quads 行（from_rdf 输入面）
fn pool_line(quad : PoolQuad) -> String {
  "\{quad.subject} \{quad.predicate} \{quad.object} ."
}

///|
/// 台账守恒键（与系统侧 quad_key 同构; graph 位恒空——池全在默认图）
fn pool_key(quad : PoolQuad) -> String {
  "\{term_key(quad.subject)}|\{quad.predicate}|\{term_key(quad.object)}|"
}

///|
/// 新引用：取值模 REF_ID_RANGE（有限取值空间利于失败复现）
fn fresh_ref(rng : @splitmix.RandomState) -> @qcs.Ref[RefId] {
  Concrete({ id: rng.next_positive_int() % REF_ID_RANGE, })
}

///|
/// P2 generator: 候选全构造 → valid 过滤 → 权重抽取（无合法候选返回 None）
///
/// **size 口径**：本骨架的 size 不参与分布——合法性由转移表决定、序列收缩由 P4
/// 负责；生成器若将来要"按 size 收束"，接在这里。
fn generate_command(
  model : Model,
  size : Int32,
  rng : @splitmix.RandomState,
) -> Command? {
  ignore(size)
  let candidates : Array[Command] = [
    Seed,
    AppendQuad(fresh_ref(rng)),
    Roundtrip,
  ]
  let names : Array[String] = ["Seed", "AppendQuad", "Roundtrip"]
  let weighted : Array[(Command, Int32)] = []
  for index = 0; index < candidates.length(); index = index + 1 {
    let command = candidates[index]
    if valid(model, command) {
      let weight = command_weight(names[index])
      if weight > 0 {
        weighted.push((command, weight))
      }
    }
  }
  let mut total = 0
  for entry in weighted {
    total = total + entry.1
  }
  if total == 0 {
    return None // 无合法候选：交给 qcs 判 Deadlock
  }
  let mut pick = rng.next_positive_int() % total
  for entry in weighted {
    if pick < entry.1 {
      return Some(entry.0)
    }
    pick = pick - entry.1
  }
  None
}
