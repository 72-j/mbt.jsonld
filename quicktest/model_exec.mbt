// ========================================
// Model Exec - 纯模型执行器 — Generated by QuickMachine Code Generator
// FSM: jsonld_dataset_ledger | Config: jsonld_conservation_machine
// Generated at: 1793000000000
// 默认实现"可运行但保守"；人工补充点以 TODO(P0)-TODO(P5) 标记
// 手维护实例（.hand-maintained 在案）:P0 接台账镜像——Seed 置池[0,1],
// AppendQuad 函数式扩集合（assign 表达力不建模集合运算, 生成器缺口同 mooncmd
// 余额算术账）, 守恒判定不住模型（模型是规格, 系统侧 conserve_verify 是律）。
// ========================================
// model_execute 是规格（specification），不是被测实现：
// 臂结构与 [[transitions]] 一一对应；纯模型与真实执行器语义漂移由属性测试双执行比较兜底

///|
/// Seed 的台账像：池索引 [0, 1]（业务面 seed 口径, 数据住 business.seed_indices）
fn model_execute(model : Model, cmd : Command) -> (Model, Response) {
  match (model.state, cmd) {
    // --- Empty ---
    // @arm Empty+Seed
    (Empty, Seed) => ({ state: Ledgered, quads: seed_indices(), }, Continue)
    // --- Ledgered ---
    // @arm Ledgered+AppendQuad（集合口径: 新索引入账, 重复追加防御归一 Error(0)）
    (Ledgered, AppendQuad(reference)) =>
      match quad_index(reference) {
        Some(index) =>
          if model.quads.contains(index) {
            (model, Error(0))
          } else {
            let next = model.quads.copy()
            next.push(index)
            ({ state: Ledgered, quads: next, }, Continue)
          }
        None => (model, Error(3))
      }
    // @arm Ledgered+Roundtrip
    (Ledgered, Roundtrip) => (model, Continue)
    // 兜底: 非法转移（valid 已过滤, 防御性保留）
    (_, _) => (model, Error(0))
  }
}

///|
/// 模型推进（quickcheck_statemachine transition_symbolic/concrete 接口形态）
/// 非法/错误响应不推进模型
fn transition(model : Model, command : Command, response : Response) -> Model {
  match response {
    Error(_) => model
    _ => model_execute(model, command).0
  }
}

///|
test "jsonld_conservation_machine model_exec: 非法转移兜底 / transition 不推进" {
  // 非法转移兜底 + transition: 错误响应不推进
  let m = model_empty()
  let (m_bad, resp_bad) = model_execute(m, AppendQuad(Concrete({ id: 1, })))
  assert_eq(resp_bad, Error(0))
  assert_eq(m_bad, m)
  let t_err = transition(m, AppendQuad(Concrete({ id: 1, })), Error(0))
  assert_eq(t_err, m)
  // transition: 正常推进
  let t_ok = transition(m, Seed, Continue)
  assert_true(t_ok != m)
  // Seed 置台账像 [0, 1]; 重复追加防御归一; 新索引扩集合
  let (seeded, resp_seed) = model_execute(m, Seed)
  assert_eq(resp_seed, Continue)
  assert_eq(seeded.quads, [0, 1])
  let (dup, resp_dup) = model_execute(seeded, AppendQuad(Concrete({ id: 1, })))
  assert_eq(resp_dup, Error(0))
  assert_eq(dup, seeded)
  let (grown, resp_grow) = model_execute(
    seeded,
    AppendQuad(Concrete({ id: 4, })),
  )
  assert_eq(resp_grow, Continue)
  assert_eq(grown.quads, [0, 1, 4])
  // Roundtrip 不动台账
  let (same, resp_rt) = model_execute(grown, Roundtrip)
  assert_eq(resp_rt, Continue)
  assert_eq(same, grown)
}
