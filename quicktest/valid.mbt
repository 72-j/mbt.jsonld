// ========================================
// Valid - 转移表约束 — Generated by QuickMachine Code Generator
// FSM: jsonld_dataset_ledger | Config: jsonld_conservation_machine
// Generated at: 1793000000000
// 默认实现"可运行但保守"；人工补充点以 TODO(P0)-TODO(P5) 标记
// 手维护实例（.hand-maintained 在案）:P0 扩集合口径——台账是集合语义,
// 重复追加（池索引已在台账）非法, valid 在生成期就挡掉。
// ========================================
// valid 是客户端契约：只有转移表声明的 (状态, 命令) 组合合法，
// 生成器据此避免非法命令序列（Deadlock 防护）

///|
/// 检查命令在当前模型状态下是否合法（源: [[transitions]] + 台账集合口径）
fn valid(model : Model, cmd : Command) -> Bool {
  match (model.state, cmd) {
    // Empty
    (Empty, Seed) => true
    // Ledgered: 追加须池索引不在台账（集合口径）; 符号引用放行（生成期）
    (Ledgered, AppendQuad(reference)) =>
      match quad_index(reference) {
        Some(index) => !model.quads.contains(index)
        None => true
      }
    (Ledgered, Roundtrip) => true
    // 兜底: 未定义转移非法
    (_, _) => false
  }
}

///|
/// 前置条件（客户端契约, quickcheck_statemachine 接口形态）
fn precondition(model : Model, command : Command) -> @qcs.Logic {
  @qcs.Logic::predicate(name="valid transition", value=valid(model, command))
}

///|
test "jsonld_conservation_machine valid: 转移表白名单 + 集合挡板冒烟" {
  // Empty: 只有 Seed 合法
  let model = model_empty()
  assert_true(valid(model, Seed))
  assert_false(valid(model, AppendQuad(Concrete({ id: 1, }))))
  assert_false(valid(model, Roundtrip))
  // Ledgered: 未追加索引合法, 已追加索引被挡
  let seeded : Model = { state: Ledgered, quads: [0, 1], }
  assert_true(valid(seeded, AppendQuad(Concrete({ id: 2, }))))
  assert_false(valid(seeded, AppendQuad(Concrete({ id: 1, }))))
  assert_true(valid(seeded, Roundtrip))
  let logic = precondition(seeded, Roundtrip)
  assert_true(logic is @qcs.Logic::Predicate(..))
}
