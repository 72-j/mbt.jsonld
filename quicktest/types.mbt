// ========================================
// Types - 类型映射层 — Generated by QuickMachine Code Generator
// FSM: jsonld_dataset_ledger | Config: jsonld_conservation_machine
// Generated at: 1793000000000
// 默认实现"可运行但保守"；人工补充点以 TODO(P0)-TODO(P5) 标记
// 手维护实例（.hand-maintained 在案）:P0 扩 Model.quads 台账镜像 +
// Continue 变体补（无发射机器不生成, 生成器缺口）+ 池长常量。
// ========================================
// 映射约定：
//   Event   → Command  （Span 载荷 → @qcs.Ref[RefId]，多载荷简化为单引用）
//   Effect  → Response （effect_maps 归一化；错误统一 Error(Int)；其余载荷不进模型）
//   Context → Model    （仅保留 Span 槽位字段，状态镜像为 ModelState）

///|
/// Span 的符号替身：生成期以 Symbolic(Var) 引用，执行期解析为 Concrete(RefId)
priv struct RefId {
  id : Int32
} derive(Eq, Debug)

///|
/// quad 池长（= ref_id_range, 索引一对一; 池内容见 business.quad_pool）
const QUAD_POOL_LEN : Int32 = 6

///|
/// Command - 测试命令类型（源: [[events]]）
priv enum Command {
  Seed
  AppendQuad(@qcs.Ref[RefId])
  Roundtrip
} derive(Eq, Debug)

///|
/// Response - 测试响应类型（源: [[effects]] + 错误归一化）
priv enum Response {
  Continue // 台账操作 + 过桥双验通过（无发射机器, 人工补）
  Error(Int32) // 引擎错误归一化（[type_mapping].error_codes）
} derive(Eq, Debug)

///|
/// ModelState - 纯模型状态枚举（镜像引擎 State 枚举，独立于引擎包）
priv enum ModelState {
  Empty
  Ledgered
} derive(Eq, Debug)

///|
/// Model - 纯模型（规格而非被测实现）
/// P0 手扩: quads = 台账的 quad 池索引集镜像（与系统 ledger 同构;
/// 函数式更新——每臂造新数组, 不用 mut 字段）
priv struct Model {
  state : ModelState
  quads : Array[Int32]
} derive(Eq, Debug)

///|
/// 初始模型：Empty，台账空
fn model_empty() -> Model {
  { state: Empty, quads: [], }
}

///|
/// 符号引用取具体值：生成期 Symbolic 返回 None，执行期 Concrete 返回 Some
fn ref_id(reference : @qcs.Ref[RefId]) -> RefId? {
  match reference {
    Concrete(id) => Some(id)
    Symbolic(_) => None
  }
}

///|
/// 载荷引用 → quad 池索引（模池长; ref_id_range == 池长时为恒等映射）
fn quad_index(reference : @qcs.Ref[RefId]) -> Int32? {
  match ref_id(reference) {
    Some(rid) => Some(rid.id % QUAD_POOL_LEN)
    None => None
  }
}

///|
test "jsonld_conservation_machine types: model_empty / ref_id 冒烟" {
  // 初始模型与引用解包
  let model = model_empty()
  assert_eq(model.state, Empty)
  assert_true(model.quads.is_empty())
  let concrete : @qcs.Ref[RefId] = Concrete({ id: 7, })
  assert_eq(ref_id(concrete), Some({ id: 7, }))
  let symbolic : @qcs.Ref[RefId] = Symbolic(@qcs.Var::{ id: 0, })
  assert_true(ref_id(symbolic) is None)
  // 载荷索引: 模池长取余 + 符号引用透 None
  assert_eq(quad_index(Concrete({ id: 7, })), Some(1))
  assert_true(quad_index(symbolic) is None)
}
